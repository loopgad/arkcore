# ArkCore 环境变量配置
#
# 复制此文件为 .env 并根据需要修改:
#   cp .env.example .env

# ========== 日志 ==========

# 日志级别 (可选值: trace, debug, info, warn, error)
# 默认为 arkcore=info
# RUST_LOG=arkcore=debug

# ========== LLM 配置 ==========

# LLM API Base URL
# ARKCORE_LLM_BASE_URL=http://localhost:11434/v1

# LLM API Key
# ARKCORE_API_KEY=sk-your-api-key

# LLM 模型名称
# ARKCORE_LLM_MODEL=gpt-4

# ========== 服务器 ==========

# HTTP 服务器监听地址
# ARKCORE_SERVER_HOST=127.0.0.1

# HTTP 服务器端口
# ARKCORE_SERVER_PORT=8080

# ========== 数据库 ==========

# SQLite 数据库路径
# ARKCORE_DB_PATH=~/.arkcore/data.db

# 数据库连接池大小
# ARKCORE_DB_POOL_SIZE=5

# ========== 安全 ==========

# 是否启用沙箱 (true/false)
# ARKCORE_SANDBOX_ENABLED=true

# ========== 平台 ==========

# 数据目录 (覆盖默认)
# ARKCORE_DATA_DIR=./data

# 配置目录 (覆盖默认)
# ARKCORE_CONFIG_DIR=./config
