# Normalize line endings
* text=auto

# Rust source files: LF only
*.rs text eol=lf
*.toml text eol=lf

# Shell scripts: LF only
*.sh text eol=lf

# YAML/CI configs: LF only
*.yml text eol=lf
*.yaml text eol=lf

# Documentation and config: LF
*.md text eol=lf
*.env text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
